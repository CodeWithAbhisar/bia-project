# ============================================================
# Backend Environment Variables - EXAMPLE FILE
# Copy this to .env and fill in your actual values.
# NEVER commit .env to git.
# ============================================================

# JWT secret - use a long random string in production
SECRET_KEY=your-strong-secret-key-here

# API key for Sarvam AI (AI chat feature)
SARVAM_API_KEY=your-sarvam-api-key-here

# Database connection string
# Local (Docker): postgresql://postgres:postgrespassword@db:5432/bi_dashboard
# Production (Neon/Supabase): postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgrespassword@db:5432/bi_dashboard

# CORS allowed origins (comma-separated). Leave as * for development.
# Production: set to your frontend URL e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=*
